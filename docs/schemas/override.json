{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerb.dev/schema/0.1/override.json",
  "title": "Override",
  "description": "One parental decision with a lifetime. Idempotent on id, immutable once issued.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "child_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lock",
        "grant",
        "unlock",
        "allowance_today"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "all",
            "device",
            "app",
            "tag"
          ]
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "app": {
          "type": "string",
          "pattern": "^(android|msstore|xbox|psn|nintendo|steam|igdb|apple|other):[^\\s]+$",
          "description": "Namespaced app key, see SPEC.md section 3.9."
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        }
      },
      "additionalProperties": false
    },
    "minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "source": {
      "type": "string",
      "pattern": "^(guardian|automation|integration):.+$"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Required. Default is end of the local day."
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "applied",
        "partial",
        "confirmed",
        "failed",
        "expired",
        "cancelled"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "enforcer",
          "status"
        ],
        "properties": {
          "enforcer": {
            "type": "string"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "applied",
              "confirmed",
              "failed",
              "unknown"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "pause",
              "zero_allowance",
              "network",
              "power",
              "manual",
              "bonus",
              "allowance"
            ]
          },
          "detail": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "restore": {
            "type": "object",
            "description": "Snapshot an emulating enforcer needs to put state back."
          }
        },
        "additionalProperties": true
      }
    },
    "cancels": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set on a compensating record."
    }
  },
  "required": [
    "id",
    "child_id",
    "kind",
    "scope",
    "source",
    "starts_at",
    "expires_at",
    "status"
  ],
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": true
}
